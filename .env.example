# Many Opinions - Environment Variables
# Set API keys for the providers you want to use.
# LiteLLM uses standard env var names for each provider.

# OpenAI
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Mistral
MISTRAL_API_KEY=

# Groq (fast inference)
GROQ_API_KEY=

# Cohere
COHERE_API_KEY=

# Together AI
TOGETHERAI_API_KEY=

# Perplexity
PERPLEXITYAI_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Fireworks AI
FIREWORKS_AI_API_KEY=

# Server config
HOST=0.0.0.0
PORT=8000

# LLM request timeout in seconds (default 120)
LLM_TIMEOUT=120

# Log level: DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=INFO
